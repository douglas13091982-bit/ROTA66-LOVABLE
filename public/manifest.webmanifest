{
  "name": "ROTA 66 - APP",
  "short_name": "ROTA 66",
  "description": "App do entregador ROTA 66 — gerencie suas entregas em tempo real.",
  "start_url": "/entregador/disponiveis",
  "scope": "/",
  "id": "/entregador",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "browser"],
  "launch_handler": { "client_mode": "focus-existing" },
  "edge_side_panel": { "preferred_width": 420 },
  "shortcuts": [
    {
      "name": "Pedidos disponíveis",
      "short_name": "Disponíveis",
      "url": "/entregador/disponiveis",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Entregas ativas",
      "short_name": "Ativas",
      "url": "/entregador/ativos",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Carteira",
      "short_name": "Carteira",
      "url": "/entregador/carteira",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Turnos",
      "short_name": "Turnos",
      "url": "/entregador/turnos",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ],
  "orientation": "portrait",
  "background_color": "#001427",
  "theme_color": "#cc2229",
  "lang": "pt-BR",
  "dir": "ltr",
  "scope_extensions": [
    { "origin": "https://www.rotas66.com.br" },
    { "origin": "https://rotas66.lovable.app" }
  ],
  "prefer_related_applications": false,
  "related_applications": [],
  "categories": [
    "business",
    "productivity"
  ],
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "screenshots": [
    {
      "src": "/screenshots/mobile-1.png",
      "sizes": "1080x1920",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Tela inicial do ROTA 66"
    },
    {
      "src": "/screenshots/mobile-2.png",
      "sizes": "1080x1920",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Acesso do entregador"
    },
    {
      "src": "/screenshots/desktop-1.png",
      "sizes": "1280x800",
      "type": "image/png",
      "form_factor": "wide",
      "label": "ROTA 66 no desktop"
    }
  ]
}
