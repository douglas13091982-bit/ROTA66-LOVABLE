{
  "manifest_version": 3,
  "name": "Rotas66 — Importar do iFood",
  "version": "1.0.0",
  "description": "Captura o catálogo da sua loja no portal do iFood e exporta um JSON pronto para importar no Rotas66.",
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["*://*.ifood.com.br/*"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png",
    "default_title": "Capturar catálogo do iFood"
  },
  "icons": { "48": "icon.png", "128": "icon.png" },
  "content_scripts": [
    {
      "matches": ["*://*.ifood.com.br/*"],
      "run_at": "document_start",
      "js": ["content.js"]
    }
  ],
  "web_accessible_resources": [
    { "resources": ["inject.js"], "matches": ["*://*.ifood.com.br/*"] }
  ]
}
